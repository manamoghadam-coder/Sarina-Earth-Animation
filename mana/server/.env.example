# Copy to .env (never commit .env)
PORT=8080
NODE_ENV=development
# Request pool: role subject to Row Level Security
DATABASE_URL=postgres://mana_app:CHANGE_ME@127.0.0.1:5432/mana
# System pool: login lookup, sessions, scheduler, migrations
DATABASE_URL_OWNER=postgres://mana_owner:CHANGE_ME@127.0.0.1:5432/mana
STORAGE_DIR=./storage
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional: natural-language understanding via Claude. Key stays on the server only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SCHEDULER=on
# Messenger channel for notifications: bale (default) | telegram | bale,telegram | (empty = off). Switching is just changing this line.
MESSENGER_PROVIDERS=bale
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Backups: interval can also be changed in the app (Settings). Unchanged data is never backed up twice.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
