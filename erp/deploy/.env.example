# --- همه‌ی مقادیر را قبل از اجرا پر کنید؛ این فایل (با نام .env) را هرگز در Git نگذارید ---
ERP_DOMAIN=erp.example.com                 # دامنه‌ای که DNS آن به این سرور اشاره می‌کند
POSTGRES_PASSWORD=                         # openssl rand -base64 24
ERP_SECRET=                                # openssl rand -hex 32  (کلید امضای نشست؛ تغییر آن همه را خارج می‌کند)
ERP_SUPERADMIN_PASSWORD=                   # گذرواژه‌ی اولیه‌ی superadmin (پس از ورود از «تغییر گذرواژه» عوض شود)
ERP_BACKUP_KEY=                            # openssl rand -base64 32 — بدون آن پشتیبان قابل بازیابی نیست؛ جدا از سرور نگه دارید
ERP_BACKUP_KEEP=14
# اختیاری: ارسال هر پشتیبان به مقصد بیرونی (مسیر فایل در BACKUP_FILE)، مثلاً با rclone:
# ERP_BACKUP_HOOK=rclone copy "$BACKUP_FILE" remote:erp-backups
