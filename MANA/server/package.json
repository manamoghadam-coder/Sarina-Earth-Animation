{
  "name": "mana-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "jalaali-js": "^2.0.1",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
